# Copy to .env (make demo does this automatically). Never commit real secrets.
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=scamshield_dev_pw
POSTGRES_DB=scamshield
# Used by the API when running inside docker compose
DATABASE_URL=postgresql://scamshield:scamshield_dev_pw@postgres:5432/scamshield
REDIS_URL=redis://redis:6379
ML_URL=http://ml:8000
# Change these for anything beyond a local demo
JWT_SECRET=change-me-local-demo-secret-at-least-32-chars
CHECK_TOKEN_SECRET=change-me-check-token-secret-at-least-32-chars
NODE_ENV=production
LOG_LEVEL=info
# Requests per minute per user on /payments/check
RATE_LIMIT_CHECK_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
ML_TIMEOUT_MS=150
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
